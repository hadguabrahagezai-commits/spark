###############################################
# SPARK — Umgebungsvariablen (Vorlage)
# Kopiere diese Datei nach .env und trage die Werte ein.
# Diese Datei niemals mit echten Schlüsseln committen.
# Ohne Schlüssel liefern die zugehörigen Routen HTTP 503; es gibt keine KI- oder Sprachplatzhalter.
###############################################

# ---------- Server ----------
PORT=5000
# Bindeadresse. Leer lassen ist der Normalfall.
# Lokal unter Windows automatisch 127.0.0.1, in Produktion automatisch 0.0.0.0.
HOST=
# Lokal: data.db  |  Auf Railway mit Volume: /data/spark.db
SQLITE_PATH=data.db
# Öffentliche Basis-URL der App (für OAuth-Rücksprünge)
APP_BASE_URL=http://localhost:5000
# Beispiel: eine lange Zufallszeichenkette, z. B. per `openssl rand -hex 32`
SESSION_SECRET=

# ---------- KI-Anbieter ----------
# Welcher Anbieter für Chat/Quiz/Analyse genutzt wird: gemini | openai | anthropic
AI_PROVIDER=gemini
# true: Serverstart abbrechen, wenn der gewählte KI-Anbieter oder die Sprach-API fehlt.
REQUIRE_LIVE_SERVICES=false

# Google Gemini  (https://aistudio.google.com/apikey)
# Beispiel: AIza...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI  (https://platform.openai.com/api-keys)
# Beispiel: sk-proj-...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Beispiel: alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1
# Zahl der jüngsten Chatnachrichten, die zusätzlich zum Langzeitgedächtnis in den KI-Kontext kommen (16–80)
CHAT_HISTORY_MESSAGES=48

# Anthropic (optional, Fallback)
# Beispiel: sk-ant-...
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---------- Stimme / Avatare ----------
# Serverseitige TTS (optional): OpenAI-Modelle via `OPENAI_TTS_MODEL` und `OPENAI_TTS_VOICE`.
# Ohne Server-TTS nutzt die App die Browser-Sprachausgabe (Web Speech API). Lokale Avatare
# und Bild-/SVG-Assets werden standardmäßig verwendet; externe Live-Avatar-Anbieter sind optional.
# (Hinweis: Falls du weiterhin ElevenLabs/HeyGen nutzen möchtest, füge die entsprechenden
# Variablen manuell ein — die Vorlage führt sie hier nicht mehr standardmäßig auf.)

# ---------- Google Cloud / OAuth ----------
# https://console.cloud.google.com/apis/credentials
# Beispiel: 1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
# Beispiel: GOCSPX-...
GOOGLE_CLIENT_SECRET=
# Muss exakt so in der Google-Konsole als „Autorisierter Weiterleitungs-URI“ hinterlegt sein
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
# Beispiel: AIza... (Maps JavaScript/Geocoding/Directions API aktivieren)
GOOGLE_MAPS_API_KEY=
# Optionaler serverseitiger API-Key für Google-Dienste ohne OAuth (z. B. YouTube Data API)
GOOGLE_API_KEY=

# ---------- Supabase ----------
# https://supabase.com/dashboard/project/_/settings/api
# Beispiel: https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Beispiel: eyJhbGciOi... (öffentlicher anon-Key)
SUPABASE_ANON_KEY=
# Beispiel: eyJhbGciOi... (service_role-Key, nur serverseitig!)
SUPABASE_SERVICE_KEY=

# ---------- Bank / Open Banking: Plaid ----------
# https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox
# Kommagetrennt, Beispiel: transactions,auth
PLAID_PRODUCTS=transactions
# Kommagetrennt, Beispiel: DE,AT,CH
PLAID_COUNTRY_CODES=DE
PLAID_REDIRECT_URI=http://localhost:5000/api/bank/callback
# Alternativ finAPI (optional)
FINAPI_CLIENT_ID=
FINAPI_CLIENT_SECRET=
FINAPI_API_URL=https://sandbox.finapi.io
